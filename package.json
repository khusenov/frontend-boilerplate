{
  "name": "frontend-boilerplate",
  "private": true,
  "version": "1.0.0",
  "description": "Production-shaped React + TypeScript frontend template: Vite, TanStack Router/Query/Form, Tailwind CSS v4 and Zod in strict Feature-Sliced Design, with layer boundaries enforced in CI.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "verify:lock": "npm ci --dry-run --ignore-scripts",
    "verify:coverage-scope": "node scripts/verify-coverage-scope.mjs",
    "verify:import-fence": "node scripts/verify-import-fence.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:a11y": "node scripts/a11y-rules.mjs --check && oxlint --deny-warnings src",
    "lint:a11y:fix": "node scripts/a11y-rules.mjs && prettier --write .oxlintrc.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "arch": "steiger ./src",
    "arch:graph": "{ echo '```mermaid'; depcruise src --no-config --ts-config tsconfig.app.json --include-only '^src' --exclude '\\.test\\.tsx?$' --output-type mermaid --collapse '^src/[^/]+/[^/]+'; echo '```'; } > docs/architecture-graph.md",
    "audit": "npm run verify:lock && npm run format:check && npm run lint && npm run lint:a11y && npm run typecheck && npm run arch && npm run build && npm run test:coverage && npm run verify:coverage-scope && npm run verify:import-fence"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-resources-to-backend": "^1.2.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.1.13",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.0",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "msw": "^3.0.5",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.9.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "lefthook": true,
    "unrs-resolver": true,
    "fsevents": false,
    "msw": false
  }
}
